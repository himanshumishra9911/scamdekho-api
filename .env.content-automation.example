# Safety switch. The normal run refuses to publish drafts unless this is true.
CONTENT_AUTOMATION_ENABLED=false
CONTENT_MAX_DRAFTS_PER_DAY=3
CONTENT_QUALITY_THRESHOLD=75
CONTENT_MIN_OPPORTUNITY_SCORE=55
CONTENT_TIMEZONE=Asia/Kolkata
# GPT-4.5 Preview is deprecated; replace this value if your API account cannot use it.
CONTENT_AI_MODEL=gpt-4.5-preview

# Existing OpenAI key. The pipeline makes one writing call per accepted topic.
OPENAI_API_KEY=

# WordPress Application Password credentials. Never use the account password.
WORDPRESS_URL=https://scamdekho.in
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_CATEGORY_IDS=

# Google Search Console + Google Sheets service account.
GSC_PROPERTY=sc-domain:scamdekho.in
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Comma-separated feed URLs and topic discovery settings.
CONTENT_RSS_FEEDS=https://www.bleepingcomputer.com/feed/,https://feeds.feedburner.com/TheHackersNews,https://krebsonsecurity.com/feed/
CONTENT_NEWS_QUERIES=online scam India,cyber fraud India,UPI fraud,phishing India,fake website scam,WhatsApp scam India,digital arrest scam
CONTENT_RELEVANCE_TERMS=scam,fraud,phishing,cybercrime,online safety,upi,otp,kyc,banking fraud,investment scam,job scam,shopping scam,loan scam,identity theft,deepfake,whatsapp scam,sms scam,email scam,fake website,digital arrest
CONTENT_TRUSTED_DOMAINS=cert-in.org.in,cybercrime.gov.in,rbi.org.in,sebi.gov.in,pib.gov.in,mha.gov.in,consumerhelpline.gov.in,google.com,microsoft.com,cloudflare.com,krebsonsecurity.com,bleepingcomputer.com,thehackernews.com,indiatoday.in,indianexpress.com,thehindu.com,livemint.com,business-standard.com,economictimes.indiatimes.com

# Optional editorial guidance, for example preferred spelling and tone.
CONTENT_VOICE_NOTES=
